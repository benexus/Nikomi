<Project Sdk="Microsoft.NET.Sdk">

  <!-- The console program AI agents and scripts use. It has no dependency beyond .NET and the core library,
       and is published next to Nikomi.exe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>NikomiCli</AssemblyName>
    <RootNamespace>Nikomi.Cli</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>

  <!-- In the Store package NikomiCli runs on the .NET that the package brings (-p:Store=true, Nikomi.csproj). -->
  <PropertyGroup Condition="'$(Store)' == 'true'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nikomi.Core\Nikomi.Core.csproj" />
  </ItemGroup>

</Project>
